{
	"name": "app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "husky",
		"typecheck": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "run-p lint:*",
		"lint:js": "eslint .",
		"lint:css": "stylelint \"src/**/*.{css,svelte}\" --allow-empty-input",
		"format": "run-s format:css format:js",
		"format:js": "prettier --write .",
		"format:css": "stylelint \"src/**/*.{css,svelte}\" --fix --allow-empty-input",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:generate": "drizzle-kit generate",
		"db:reset": "rm -rf .wrangler/state/v3/d1 && wrangler d1 migrations apply consueloc-erp-db --local && npm run db:seed",
		"db:seed": "wrangler d1 execute consueloc-erp-db --local --file scripts/seed.sql",
		"db:export": "wrangler d1 export consueloc-erp-db --remote --output db-export.sql",
		"env:create": "wrangler d1 create consueloc-erp-db && wrangler r2 bucket create consueloc-erp-arch"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"eslint-plugin-unicorn": "^77.0.0",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"npm-run-all2": "^8.0.4",
		"postcss-html": "^2.0.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"stylelint": "^17.15.0",
		"stylelint-config-html": "^2.0.0",
		"stylelint-config-recess-order": "^7.8.0",
		"stylelint-config-standard": "^40.0.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"zod": "^4.6.5"
	}
}
