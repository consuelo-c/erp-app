        "cash_movements_amount": {
          "name": "cash_movements_amount",
          "value": "\"cash_movements\".\"amount\" <> 0"
        },
        "cash_movements_entity_pair": {
          "name": "cash_movements_entity_pair",
          "value": "(\"cash_movements\".\"entity_type\" IS NULL) = (\"cash_movements\".\"entity_id\" IS NULL)"
        },
        "cash_movements_concept_link": {
          "name": "cash_movements_concept_link",
          "value": "CASE\n\t\t\t\tWHEN \"cash_movements\".\"concept\" IN ('INSTALLMENT', 'SECURITY_DEPOSIT') THEN \"cash_movements\".\"entity_type\" IS 'ORDER' AND (\"cash_movements\".\"amount\" > 0) = (\"cash_movements\".\"reverses_id\" IS NULL)\n\t\t\t\tWHEN \"cash_movements\".\"concept\" IN ('INSTALLMENT_REFUND', 'DEPOSIT_REFUND', 'CARRIER_PAYMENT') THEN \"cash_movements\".\"entity_type\" IS 'ORDER' AND (\"cash_movements\".\"amount\" < 0) = (\"cash_movements\".\"reverses_id\" IS NULL)\n\t\t\t\tWHEN \"cash_movements\".\"concept\" = 'PAYROLL' THEN \"cash_movements\".\"entity_type\" IS 'PAYROLL_RUN' AND (\"cash_movements\".\"amount\" < 0) = (\"cash_movements\".\"reverses_id\" IS NULL)\n\t\t\t\tWHEN \"cash_movements\".\"concept\" = 'OTHER_INCOME' THEN \"cash_movements\".\"entity_type\" IS NULL AND (\"cash_movements\".\"amount\" > 0) = (\"cash_movements\".\"reverses_id\" IS NULL)\n\t\t\t\tWHEN \"cash_movements\".\"concept\" = 'OTHER_EXPENSE' THEN \"cash_movements\".\"entity_type\" IS NULL AND (\"cash_movements\".\"amount\" < 0) = (\"cash_movements\".\"reverses_id\" IS NULL)\n\t\t\t\tELSE 0\n\t\t\tEND"
        },
        "cash_movements_payment_method": {
          "name": "cash_movements_payment_method",
          "value": "\"cash_movements\".\"payment_method\" IN ('CASH', 'TRANSFER', 'OTHER')"
        }
      }
    },
